{
  "name": "sneakychat",
  "version": "1.0.0",
  "description": "Anonymous peer-to-peer chat with berry economy — full-stack Svelte + Express",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspaces",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "type-check": "npm run type-check --workspaces",
    "check": "npm run check --workspace=client && npm run type-check --workspace=server"
  },
  "devDependencies": {},
  "keywords": [
    "chat",
    "anonymous",
    "svelte",
    "express",
    "socket.io"
  ],
  "author": "",
  "license": "MIT"
}